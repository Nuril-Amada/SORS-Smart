{
  "openapi": "3.0.3",
  "info": {
    "title": "SORS API - Smart Oil Report System",
    "description": "API dokumentasi untuk sistem SORS (Smart Oil Report System) - Manajemen Neraca Massa Tangki Minyak Kelapa Sawit.\n\n## Cara Penggunaan\n1. Lakukan **Register** atau **Login** terlebih dahulu\n2. Gunakan endpoint **Import** untuk memasukkan data transaksi dari file CSV\n3. Akses **Dashboard** untuk melihat summary KPI dan analitik variansi\n",
    "version": "1.0.0",
    "contact": {
      "name": "SORS Development Team",
      "email": "dev@sors.local"
    }
  },
  "servers": [
    {
      "url": "http://localhost/oilreport/backend",
      "description": "Local Apache24 Development Server"
    },
    {
      "url": "http://localhost/backend",
      "description": "Local Backend Direct"
    }
  ],
  "tags": [
    { "name": "Auth", "description": "Autentikasi & Manajemen User" },
    { "name": "Products", "description": "Master Data Material & Nomor Seri Produk" },
    { "name": "Transactions", "description": "Log Transaksi Neraca Massa Tangki Minyak" },
    { "name": "Dashboard", "description": "KPI Summary, Analitik Stok, & Variansi Gain/Loss" },
    { "name": "Import", "description": "Import Data Transaksi dari File CSV/Excel" }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Registrasi User Baru",
        "description": "Mendaftarkan akun pengguna baru. Password di-hash menggunakan BCRYPT. Setelah berhasil, frontend diarahkan ke halaman login.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" },
              "example": {
                "full_name": "Aulia Anantiyo",
                "username": "aulia",
                "password": "password123",
                "confirm_password": "password123"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registrasi berhasil",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Registrasi berhasil! Silakan login untuk masuk ke sistem SORS.",
                  "data": { "redirect": "/login", "username": "aulia" }
                }
              }
            }
          },
          "400": { "description": "Validasi gagal (field kosong, password tidak cocok, username duplikat)" },
          "500": { "description": "Kesalahan server" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login User",
        "description": "Autentikasi pengguna menggunakan username dan password. Mengembalikan data user jika berhasil.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "example": {
                "username": "aulia",
                "password": "password123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login berhasil",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Login berhasil!",
                  "data": {
                    "user": {
                      "id": 1,
                      "full_name": "Aulia Anantiyo",
                      "username": "aulia",
                      "role": "user",
                      "created_at": "2026-09-22 08:40:00"
                    },
                    "redirect": "/dashboard"
                  }
                }
              }
            }
          },
          "400": { "description": "Field tidak lengkap" },
          "401": { "description": "Username atau password tidak valid" },
          "500": { "description": "Kesalahan server" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Info User Saat Ini",
        "description": "Mengambil data profil pengguna berdasarkan ID.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Data user berhasil diambil",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Data user berhasil diambil.",
                  "data": {
                    "id": 1,
                    "full_name": "Aulia Anantiyo",
                    "username": "aulia",
                    "role": "user",
                    "created_at": "2026-09-22 08:40:00"
                  }
                }
              }
            }
          },
          "404": { "description": "User tidak ditemukan" }
        }
      }
    },
    "/products": {
      "get": {
        "tags": ["Products"],
        "summary": "List Master Produk",
        "description": "Mengambil seluruh data master material dan nomor seri produk.",
        "responses": {
          "200": {
            "description": "Data produk berhasil diambil",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Data produk berhasil diambil.",
                  "data": [
                    { "id": 1, "material_code": "MAT-CPO-001", "product_name": "CPO", "description": "Crude Palm Oil", "created_at": "2026-09-22 08:00:00" }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Products"],
        "summary": "Tambah Produk Baru",
        "description": "Menambahkan master data produk baru dengan nomor seri material unik.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProductRequest" },
              "example": {
                "material_code": "MAT-CPO-001",
                "product_name": "CPO",
                "description": "Crude Palm Oil Bahan Baku"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Produk berhasil ditambahkan" },
          "400": { "description": "Validasi gagal atau material_code duplikat" }
        }
      }
    },
    "/products/{id}": {
      "put": {
        "tags": ["Products"],
        "summary": "Edit Produk",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProductRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Produk berhasil diperbarui" },
          "404": { "description": "Produk tidak ditemukan" }
        }
      },
      "delete": {
        "tags": ["Products"],
        "summary": "Hapus Produk",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Produk berhasil dihapus" },
          "404": { "description": "Produk tidak ditemukan" }
        }
      }
    },
    "/transactions": {
      "get": {
        "tags": ["Transactions"],
        "summary": "List Data Transaksi Neraca Massa",
        "description": "Mengambil log transaksi harian tangki minyak dengan dukungan filter dan paginasi.",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "Nomor halaman" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 }, "description": "Jumlah data per halaman (max 500)" },
          { "name": "tfarm", "in": "query", "schema": { "type": "string" }, "description": "Filter area farm (contoh: C - 2, B - 1)", "example": "B - 1" },
          { "name": "tank", "in": "query", "schema": { "type": "string" }, "description": "Filter kode tangki (pencarian parsial)", "example": "TB1" },
          { "name": "product_name", "in": "query", "schema": { "type": "string" }, "description": "Filter nama produk", "example": "RBD Olein" },
          { "name": "start_date", "in": "query", "schema": { "type": "string", "format": "date" }, "description": "Tanggal awal (YYYY-MM-DD)" },
          { "name": "end_date", "in": "query", "schema": { "type": "string", "format": "date" }, "description": "Tanggal akhir (YYYY-MM-DD)" },
          { "name": "over_threshold", "in": "query", "schema": { "type": "string", "enum": ["1", "0"] }, "description": "Filter variansi >0.2% (1 = Ya, 0 = Tidak)" }
        ],
        "responses": {
          "200": {
            "description": "Data transaksi berhasil diambil",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Data transaksi berhasil diambil.",
                  "data": {
                    "page": 1, "limit": 50, "total_records": 1250, "total_pages": 25,
                    "items": [
                      {
                        "id": 1,
                        "transaction_date": "2026-08-31",
                        "tfarm": "B - 1",
                        "tank": "TB1",
                        "product_name": "RBD Olein",
                        "beginning_stock": 1500000.00,
                        "ending_stock": 1480000.00,
                        "gl_amount": -200.00,
                        "gl_percentage": -0.0133,
                        "over_threshold": ""
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{id}": {
      "get": {
        "tags": ["Transactions"],
        "summary": "Detail Transaksi",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Detail transaksi ditemukan" },
          "404": { "description": "Transaksi tidak ditemukan" }
        }
      },
      "delete": {
        "tags": ["Transactions"],
        "summary": "Hapus Transaksi",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Transaksi berhasil dihapus" },
          "404": { "description": "Transaksi tidak ditemukan" }
        }
      }
    },
    "/dashboard/summary": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "KPI Summary Lengkap",
        "description": "Mengambil ringkasan eksekutif meliputi stok per produk, jumlah alert variansi >0.2%, pareto analisa penyebab, dan status per area farm.",
        "responses": {
          "200": {
            "description": "Data summary berhasil diambil",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Data summary dashboard SORS berhasil diambil.",
                  "data": {
                    "product_stocks": [
                      { "product_name": "CPO", "total_beginning_stock": 5000000, "total_ending_stock": 4950000, "total_inflow": 200000, "total_outflow": 250000 }
                    ],
                    "alerts_count": 12,
                    "root_cause_pareto": [
                      { "cause_analysis": "Loss penerimaan cpo dari bulking perak", "occurrences": 8, "total_variance_volume": 15400.50 }
                    ],
                    "farm_status": [
                      { "tfarm": "B - 1", "total_tanks": 6, "current_stock": 8500000, "farm_alerts": 2 }
                    ],
                    "global_totals": {
                      "total_transaction_logs": 1250,
                      "global_beginning": 45000000,
                      "global_ending": 44850000,
                      "global_net_gl": -150000
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/stock-per-product": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Stok Per Jenis Produk",
        "description": "Mengambil total stok awal, stok akhir, inflow, dan outflow dikelompokkan per jenis produk minyak.",
        "responses": { "200": { "description": "Stok per produk berhasil diambil" } }
      }
    },
    "/dashboard/variance-pareto": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Pareto Analisa Penyebab Variance",
        "description": "Mengambil distribusi frekuensi dan total volume loss/gain berdasarkan kolom Analisa Penyebab untuk visualisasi grafik Pareto.",
        "responses": { "200": { "description": "Data pareto berhasil diambil" } }
      }
    },
    "/dashboard/farm-status": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Status Per Area Farm Tangki",
        "description": "Mengambil ringkasan kondisi setiap kelompok area farm (C, I, P, F, B, TTF) beserta jumlah tangki, stok terkini, dan jumlah alert.",
        "responses": { "200": { "description": "Status farm berhasil diambil" } }
      }
    },
    "/import/transactions": {
      "post": {
        "tags": ["Import"],
        "summary": "Import Data Transaksi dari CSV",
        "description": "Menerima file CSV hasil export dari `oil report.xlsx` atau payload JSON array untuk bulk insert ke tabel `oil_transaction`. Sistem secara otomatis menghitung flag `over_threshold` jika variansi G-L > 0.2%.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary", "description": "File CSV transaksi minyak" },
                  "user_id": { "type": "integer", "description": "ID user yang melakukan import" }
                }
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": { "type": "integer" },
                  "rows": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/TransactionRow" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Data berhasil diimpor",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Berhasil mengimpor 1250 data transaksi ke database.",
                  "data": { "imported_count": 1250 }
                }
              }
            }
          },
          "400": { "description": "File tidak valid atau data kosong" },
          "500": { "description": "Gagal bulk insert ke database" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": ["full_name", "username", "password", "confirm_password"],
        "properties": {
          "full_name": { "type": "string", "example": "Aulia Anantiyo" },
          "username": { "type": "string", "example": "aulia" },
          "password": { "type": "string", "minLength": 6, "example": "password123" },
          "confirm_password": { "type": "string", "example": "password123" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "example": "aulia" },
          "password": { "type": "string", "example": "password123" }
        }
      },
      "ProductRequest": {
        "type": "object",
        "required": ["material_code", "product_name"],
        "properties": {
          "material_code": { "type": "string", "example": "MAT-CPO-001" },
          "product_name": { "type": "string", "example": "CPO" },
          "description": { "type": "string", "example": "Crude Palm Oil Bahan Baku" }
        }
      },
      "TransactionRow": {
        "type": "object",
        "properties": {
          "transaction_date": { "type": "string", "format": "date", "example": "2026-08-31" },
          "tfarm": { "type": "string", "example": "B - 1" },
          "tank": { "type": "string", "example": "TB1" },
          "product_tankfarm": { "type": "string", "example": "NBDPO 1st HG" },
          "product_name": { "type": "string", "example": "RBD Olein" },
          "beginning_stock": { "type": "number", "example": 1500000.00 },
          "ending_stock": { "type": "number", "example": 1480000.00 },
          "gl_amount": { "type": "number", "example": -200.00 },
          "gl_percentage": { "type": "number", "example": -0.0133 },
          "over_threshold": { "type": "string", "example": "" },
          "cause_analysis": { "type": "string", "example": "Selisih sounding dan temperature" }
        }
      }
    }
  }
}
