# ============================================================
# SORS (Smart Oil Report System) - Apache24 Rewrite Config
# File: backend/.htaccess
# Fungsi: Mengarahkan semua request ke index.php (Front Controller)
# ============================================================

Options -MultiViews
RewriteEngine On

# Izinkan akses langsung ke folder docs/ (Swagger UI)
RewriteCond %{REQUEST_URI} ^/oilreport/backend/docs/ [OR]
RewriteCond %{REQUEST_URI} ^/backend/docs/
RewriteRule ^ - [L]

# Abaikan jika request ke file/folder yang benar-benar ada
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Arahkan semua request lain ke index.php
RewriteRule ^ index.php [QSA,L]
